<?xml version="1.0" encoding="utf-8" ?>
<apiSettings>
  <api name="default" source="cardService" ssl ="true"
       bypassCertVerification="true"
       includeRequestHeadersInTrackingLog="true"
       includeResponseHeadersInTrackingLog="true"
       requestDataFormat="none/formurlencoded/xml/Json(default)"
       serializer="newtonsoft/default"
       disabled ="false">

    <!--mockService only effect when api disabled = true and mockService.enable = true, if api disabled = true and mockService.enable = false. it will be call mock file only-->
    <mockService url="https://accessone-mock.local/api/mock" environment="QA" module="BOARDING" source="agnostic" version="v2" enabled="true"></mockService>
    
    <baseUrl value="http://echo-qa.local/Sprint7/api/cardService" />
    
    <clientCertificate file="tfdc-cat-2014-2016.pfx" password="" encrypted="false" />

    <authentication mode="none"/>

    <proxy enable="true">
      <add name="address" value="address" />
      <add name="domain" value="domain" />
      <add name="username" value="adsada" encrypted="false" encryptKey="12312313" />
      <add name="password" value="adsada" encrypted="false" encryptKey="12312313" />
      <add name="bypassOnlocal" value="true" />

      <section name="bypassList">
        <add value="1.1.1.1" />
        <add value="2.2.2.2" />
      </section>
    </proxy>

    <messageSettings defaultRemapMesssageCode="500">
      <message source="cardDetails" type="" code="" description="Card/Pin Mailer indicator is not applicable for empty (Primary|Alternative) Address." remapMessageCode="200" remapMessageType="BE" />
    </messageSettings>
  </api>

  <api name="getToken" source="cardService" ssl ="false">
    <mockFile value="test.json" />
    <authentication mode="none" />

    <section name="authInfo">
      <add name="grantType" value="" />
      <add name="userName" value="" encrypted="true" encryptKey="12312313" />
      <add name="password" value="" encrypted="true" encryptKey="12312313" />
    </section>
  </api>

  <api name="updateCardDetails" source="cardService" bypassCertVerification="true" inheritMessageSources="cardDetails" >
    <messageSettings />
  </api>
</apiSettings>